rules_version = '2';

// Learn & Play PK — Firestore security rules
// Deploy: firebase deploy --only firestore:rules
//
// NOTE: Firestore rules do NOT allow partial-segment wildcards.
// Dynamic per-topic collections are matched generically and guarded with matches() below.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function sanityScore() {
      return request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 1000000;
    }

    // users/{uid} — profile owned by the user; entitlement fields locked to server
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
          ['uid','name','displayName','avatar','email','xp','coins','streak','bestStreak',
           'lastActiveDay','freezes','hints','badges','wordsLearned','quizCorrect','perfectScores',
           'results','premium','premiumExpiry','isPremium','premiumPlan','premiumSince',
           'rewardCycleDay','lastRewardDay','lang','fcmToken','updatedAt','createdAt','rewards'])
        && request.resource.data.xp is int && request.resource.data.xp >= 0
        && request.resource.data.xp <= 5000000
        && request.resource.data.coins is int && request.resource.data.coins >= 0
        && request.resource.data.coins <= 100000
        && (!('isPremium' in request.resource.data) || request.resource.data.isPremium == false);
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // leaderboards/{slug}/scores/{id} — public read, create-only for the owner
    match /leaderboards/{slug}/scores/{scoreId} {
      allow read: if true;
      allow create: if isSignedIn() && sanityScore()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 24;
      allow update, delete: if false;
    }

    match /content_words/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.en is string && request.resource.data.en.size() <= 64
        && request.resource.data.ur is string && request.resource.data.ur.size() <= 64;
      allow update, delete: if false;
    }

    // Dynamic per-topic admin queues (content_questions_gk, content_questions_pakistan, …)
    // Generic two-segment match guarded by matches() — only affects content_questions_* collections.
    match /{collection}/{id} {
      allow read: if collection.matches('content_questions_.*') && isSignedIn();
      allow create: if collection.matches('content_questions_.*') && isSignedIn()
        && request.resource.data.q is string;
      allow update, delete: if false;
    }

    // server-only (Admin SDK bypasses rules)
    match /_rate/{id} {
      allow read, write: if false;
    }
    match /payments/{id} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
  }
}
