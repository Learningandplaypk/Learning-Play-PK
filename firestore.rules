rules_version = '2';

// Learn & Play PK — Firestore security rules
// Deploy: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function sanityScore() {
      return request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 1000000;
    }

    // users/{uid} — profile owned by the user; leaderboard fields locked
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(
          ['uid','name','displayName','avatar','email','xp','coins','streak','bestStreak',
           'lastActiveDay','freezes','hints','badges','wordsLearned','quizCorrect','perfectScores',
           'results','premium','premiumExpiry','isPremium','premiumPlan','premiumSince',
           'rewardCycleDay','lastRewardDay','lang','fcmToken','updatedAt','createdAt','rewards'])
        && request.resource.data.xp is int && request.resource.data.xp >= 0
        && request.resource.data.xp <= 5000000
        && request.resource.data.coins is int && request.resource.data.coins >= 0
        && request.resource.data.coins <= 100000
        && (!('isPremium' in request.resource.data) || request.resource.data.isPremium == false);
      allow delete: if isOwner(uid);
    }

    // leaderboards/{slug}/scores/{id} — create-only for signed-in users; no edit/delete
    match /leaderboards/{slug}/scores/{scoreId} {
      allow read: if true;
      allow create: if isSignedIn() && sanityScore()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 24;
      allow update, delete: if false;
    }

    // admin content queue — write-only for signed-in admins panel users
    match /content_words/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.en is string && request.resource.data.en.size() <= 64
        && request.resource.data.ur is string && request.resource.data.ur.size() <= 64;
      allow update, delete: if false;
    }
    match /content_questions_{topic}/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.q is string;
      allow update, delete: if false;
    }

    // server-only rate limiting + payment logs
    match /_rate/{id} {
      allow read, write: if false; // admin SDK bypasses rules
    }
    match /payments/{id} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false; // server only via webhooks
    }
  }
}
