# ── Learn & Play PK — Environment Variables ──────────────────────────────
# Copy this file to .env.local and fill values. App EVERYTHING works without
# these (guest mode, local storage, no ads/email) — keys unlock cloud features.

# ── Site ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://learnplaypk.com

# ── Firebase (client) — progress sync, auth, leaderboards ────────────────
# Firebase Console → Project settings → Your apps → Web app → Config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Web Push certificate key (VAPID) — optional, for streak push notifications
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ── Firebase (server, admin) — webhooks, cron, server leaderboard ────────
# Service account JSON (full) OR the SDK config as a JSON string:
FIREBASE_SERVICE_ACCOUNT_KEY=
# convenience vars (if not pasting full JSON):
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ── Payments ──────────────────────────────────────────────────────────────
# Stripe (international cards). Test keys start with sk_test_
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Safepay (JazzCash / EasyPaisa / PK cards) — getsafepay.com
SAFEPAY_SECRET_KEY=
SAFEPAY_ENV=sandbox   # sandbox | production

# ── Email (transactional) ────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Learn & Play PK <salam@learnplaypk.com>"

# ── Push notifications (streak reminders via cron) ───────────────────────
FCM_SERVER_KEY=
CRON_SECRET=            # protects /api/cron/streak-reminder

# ── Admin ────────────────────────────────────────────────────────────────
# Comma-separated admin emails for /admin panel access
NEXT_PUBLIC_ADMIN_EMAILS=

# ── Google AdSense (guest-only ads; premium = zero ads) ──────────────────
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_BRAIN=
NEXT_PUBLIC_ADSENSE_SLOT_QUIZ=
NEXT_PUBLIC_ADSENSE_SLOT_FUN=
NEXT_PUBLIC_ADSENSE_SLOT_LEARN=
NEXT_PUBLIC_ADSENSE_REWARDED_SLOT=   # rewarded video → +1 heart in games
